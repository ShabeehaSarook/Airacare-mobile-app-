<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/airacare_black"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/historyTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detection_history_title"
        android:textColor="@color/airacare_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/historySummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/detection_history_summary_empty"
        android:textColor="@color/airacare_soft_white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/historyBackButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/back_button" />

        <Button
            android:id="@+id/historyRefreshButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/refresh_button" />
    </LinearLayout>

    <Button
        android:id="@+id/firebaseTestButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/firebase_test_button" />

    <TextView
        android:id="@+id/firebaseTestStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/firebase_test_ready"
        android:textColor="@color/airacare_soft_white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/historyEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/status_background"
        android:padding="16dp"
        android:text="@string/detection_history_empty"
        android:textColor="@color/airacare_soft_white"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/historyListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
