<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/collectionRoot" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="#090D12" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageButton android:id="@+id/capturedPetsBackButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_collection_back" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back_button"/>
  <TextView android:id="@+id/collectionHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/my_collection_button" android:textColor="#F3F6F7" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
  <ImageButton android:id="@+id/capturedPetsRefreshButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_collection_refresh" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/refresh_button"/>
 </LinearLayout>
 <TextView android:id="@+id/capturedPetsSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:textColor="#AAB8C0" android:textSize="17sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:background="@drawable/collection_image_panel_background">
 <Button android:id="@+id/filterAllButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:padding="8dp" android:background="@drawable/collection_filter_background" android:backgroundTint="@null" android:textColor="@color/collection_filter_text" android:text="@string/filter_all" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
<Button android:id="@+id/filterDogsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:padding="8dp" android:background="@drawable/collection_filter_background" android:backgroundTint="@null" android:textColor="@color/collection_filter_text" android:text="@string/filter_dogs" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
<Button android:id="@+id/filterCatsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:padding="8dp" android:background="@drawable/collection_filter_background" android:backgroundTint="@null" android:textColor="@color/collection_filter_text" android:text="@string/filter_cats" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:stateListAnimator="@null"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/collectionLoading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="12dp" android:indeterminate="true" android:indeterminateTint="#44D7BA" android:visibility="gone"/>
 <Button android:id="@+id/collectionRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Could not refresh. Tap to retry" android:textColor="#F3F6F7" android:background="@drawable/collection_filter_background" android:visibility="gone"/>
 <TextView android:id="@+id/capturedPetsEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="32dp" android:gravity="center" android:text="Your collection is waiting" android:textColor="#AAB8C0" android:textSize="20sp" android:visibility="gone"/>
 <ListView android:id="@+id/capturedPetsList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:divider="@android:color/transparent" android:dividerHeight="16dp" android:listSelector="@android:color/transparent" android:clipToPadding="false" android:paddingBottom="16dp"/>
</LinearLayout>
