<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <ImageView
        android:id="@+id/capturePreviewImage"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:adjustViewBounds="true"
        android:background="@drawable/capture_preview_background"
        android:contentDescription="@string/capture_store_button"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/capturePreviewTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/airacare_black"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/capturePreviewDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/airacare_black"
        android:textSize="13sp" />
</LinearLayout>
